---
import type { MarkdownHeading } from "astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

type Props = {
  headings: MarkdownHeading[];
  enabled?: boolean;
};

const { headings, enabled = true } = Astro.props;
const t = useTranslations(Astro.currentLocale ?? config.site.lang);
// Preserve the existing remark-toc workflow when an author supplies a manual TOC.
const hasManualToc = headings.some(heading =>
  /^(table of contents|toc)$/i.test(heading.text.trim())
);
const entries = headings.filter(
  heading => heading.depth >= 2 && heading.depth <= 4
);
const baseDepth = Math.min(...entries.map(heading => heading.depth));
---

{
  enabled && !hasManualToc && entries.length > 0 && (
    <aside class="toc my-8" data-pagefind-ignore>
      <details open class="border-border rounded border px-4 py-3">
        <summary class="cursor-pointer font-medium">
          {t.post.tableOfContents}
        </summary>
        <nav aria-label={t.post.tableOfContents} class="mt-3">
          <ul class="space-y-2 text-sm">
            {entries.map(heading => (
              <li
                style={{
                  paddingInlineStart: `${(heading.depth - baseDepth) * 0.875}rem`,
                }}
              >
                <a
                  href={`#${heading.slug}`}
                  class="text-foreground hover:text-accent block wrap-break-word decoration-dashed underline-offset-4 hover:underline"
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </details>
    </aside>
  )
}

<style>
  @media (min-width: 1280px) {
    .toc {
      position: fixed;
      inset-block-start: 8rem;
      inset-inline-start: calc(50% + 25rem);
      width: 14rem;
      max-height: calc(100dvh - 10rem);
      overflow-y: auto;
      overscroll-behavior: contain;
      margin: 0;
    }
  }
</style>
