---
import { Image } from "astro:assets";
import { getCollection, render, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import ProjectMeta from "@/components/ProjectMeta.astro";
import config from "@/config";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => !data.draft);
  return projects.map(project => ({
    params: { slug: project.id },
    props: { project },
  }));
}

type Props = { project: CollectionEntry<"projects"> };
const { project } = Astro.props;
const { Content, headings } = await render(project);
---

<Layout
  title={`${project.data.title} | ${config.site.title}`}
  description={project.data.description}
  ogImage={project.data.cover?.src}
>
  <Header />
  <Breadcrumb />
  <Main pageTitle={project.data.title} pageDesc={project.data.description}>
    {
      project.data.cover && (
        <Image
          src={project.data.cover}
          alt={project.data.coverAlt ?? project.data.title}
          widths={[720, 1440]}
          sizes="(min-width: 768px) 736px, calc(100vw - 32px)"
          class="border-border mb-6 h-auto w-full rounded-lg border"
          loading="eager"
        />
      )
    }
    <ProjectMeta project={project} />
    <TableOfContents headings={headings} enabled={project.data.showToc} />

    <article class="app-prose mt-8 max-w-none">
      <Content />
    </article>
  </Main>
  <Footer />
</Layout>
