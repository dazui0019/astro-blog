---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import ProjectMeta from "@/components/ProjectMeta.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const projects = (
  await getCollection("projects", ({ data }) => !data.draft)
).sort(
  (a, b) =>
    Number(b.data.featured) - Number(a.data.featured) ||
    a.data.order - b.data.order ||
    a.data.title.localeCompare(b.data.title)
);
---

<Layout
  title={`${t.nav.projects} | ${config.site.title}`}
  description={t.project.description}
>
  <Header />
  <Breadcrumb />
  <Main pageTitle={t.nav.projects} pageDesc={t.project.description}>
    {
      projects.length === 0 ? (
        <p class="my-6 opacity-75">{t.project.empty}</p>
      ) : (
        <ul class="grid gap-x-6 gap-y-8 sm:grid-cols-2">
          {projects.map(project => (
            <li class="min-w-0">
              {project.data.cover && (
                <a
                  href={getRelativeLocaleUrl(locale, `projects/${project.id}`)}
                  class="group border-border bg-muted mb-4 block overflow-hidden rounded-lg border"
                  aria-label={project.data.title}
                  tabindex="-1"
                >
                  <Image
                    src={project.data.cover}
                    alt={project.data.coverAlt ?? project.data.title}
                    widths={[360, 720, 1080]}
                    sizes="(min-width: 640px) 352px, calc(100vw - 32px)"
                    class="aspect-video w-full object-cover motion-safe:transition-transform motion-safe:duration-300 motion-safe:group-hover:scale-105"
                    loading="lazy"
                  />
                </a>
              )}
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <a
                  href={getRelativeLocaleUrl(locale, `projects/${project.id}`)}
                  class="text-accent inline-block text-lg font-medium decoration-dashed underline-offset-4 hover:underline"
                >
                  <h2>{project.data.title}</h2>
                </a>
                {project.data.featured && (
                  <span class="text-sm opacity-75">{t.project.featured}</span>
                )}
              </div>
              <p class="mt-2">{project.data.description}</p>
              <ProjectMeta project={project} />
            </li>
          ))}
        </ul>
      )
    }
  </Main>
  <Footer />
</Layout>
